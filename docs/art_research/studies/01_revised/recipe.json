      "within": "field",
      "include_caster_if_eligible": true,
      "max": 12,
      "ordering": [
        "distance",
        "stable_world_key"
      ]
    }
  },
  "Relations": {
    "pull": {
      "channel": "gravity",
      "from": "field",
      "to": "receiver",
      "direction": "radial_in_3d",
      "profile": "compact_quartic_soft_center",
      "center_softening_m": 0.25,
      "peak_m_s2": 6,
      "amplitude": "reserve_ratio_latched_at_commit",
      "occlusion": "none_by_ordinary_walls",
      "requires": [
        "Contracts.account",
        "Contracts.basis"
      ],
      "output": "delivered_impulse_by_recipient"
    }
  },
  "Processes": {
    "prepare": {
      "entry": "hold_with_valid_aim",
      "deadline_s": 2.5,
      "while": [
        "reserve_from_caster_up_to_quote",
        "steer_desired_center_within_contract"
      ],
      "external_effects": [],
      "edges": [
        {
          "on": [
            "interrupt",
            "source_lost",
            "timeout",
            "release_below_quote",
            "release_at_invalid_center"
          ],
          "to": "close"
        },
        {
          "on": "release_with_valid_center_and_funded_threshold",
          "atomic": [
            "capture_realized_legal_center",
            "lock_reserve_ratio",
            "activate_field_and_support",
            "emit_commit"
          ],
          "to": "active"
        }
      ]
    },
    "active": {
      "deadline_s": 1.25,
      "tick": [
        "advance_realized_center_with_clearance",
        "query_receiver_at_realized_center",
        "allocate_pull_and_submit",
        "publish_snapshot_and_receipts"
      ],
      "edges": [
        {
          "on": [
            "timeout",
            "depleted",
            "basis_lost",
            "interrupt"
          ],
          "to": "close"
        }
      ]
    },
    "close": {
      "once": [
        "withdraw_extra_acceleration",
        "settle_used_and_release_unspent_reservations",
        "release_control",
        "publish_exit"
      ],
      "persistence": "previous_velocities_contacts_and_committed_world_changes"
    }
  },
  "Contracts": {
    "steer": {
      "writer": "caster",
      "bind": "live_aim_during_prepare",
      "max_reach_m": 9,
      "max_speed_m_s": 4,
      "invalid_new_aim": "retain_last_legal_preview_and_mark_release_invalid"
    },
    "descent": {
      "bind": "capture_on_commit",
      "axis": "world_down",
      "travel_m": 1.2,
      "duration_s": 0.9,
      "ease": "smoothstep",
      "clearance_m": 0.3,
      "at_limit": "clamp_center_keep_field",
      "reference_lost": "close"
    },
    "account": {
      "payer": "caster",
      "version": "research_quote_proposed_0.1",
      "capacity": "quote_by_user_scale_geometry_duration",
      "gate": "quoted_min_release",
      "settlement": "reserve_then_charge_committed_cost_only",
      "step_limit": "quoted_remaining_impulse",
      "allocation": "proportional_to_requested_magnitude_same_snapshot",
      "out_of_funds": "close"
    },
    "basis": {
      "provider": "finite_arcane_support",
      "reaction": "accept_equal_opposite_impulse_within_capacity",
      "energy": "finite_work_allowance_from_quoted_reserve",
      "no_sink": "deny_commit_or_close"
    },
    "input_priority": [
      "interrupt_or_source_lost",
      "timeout",
      "release",
      "hold"
    ],
    "clocks": {
      "physics_hz": 60,
      "history_samples": 16,
