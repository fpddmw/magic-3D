class RuntimeEvent extends RefCounted:
	var type: String
	var cast_instance_id: String
	var source_subject_id: String
	var source_process_id: String
	var payload: Dictionary
	var sim_tick: int

	func _init(
		p_type: String = "",
		p_cast_id: String = "",
		p_subject_id: String = "",
		p_process_id: String = "",
		p_payload: Dictionary = {},
		p_tick: int = 0
	) -> void:
		type = p_type
		cast_instance_id = p_cast_id
		source_subject_id = p_subject_id
		source_process_id = p_process_id
		payload = p_payload
		sim_tick = p_tick
