{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fpddmw.github.io/magic-3D/schema/magic_dsl_v0_2.schema.json",
  "title": "CompiledSpellDSL v0.2.2",
  "description": "Strict structural contract for Magic DSL v0.2.2: full combat ContractSpec with ON_INTERRUPT, state-driven ArtKit art_overrides, carrier-scoped SpatialDistribution, orthogonal PropagationSpec, material x initial_phase compatibility, and phase-restricted process_graph operations.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "spell_id",
    "display_name",
    "contract",
    "subjects",
    "spatial",
    "relations",
    "process_graph",
    "expression",
    "budget"
  ],
  "properties": {
    "schema_version": { "const": "0.2.2" },
    "spell_id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$",
      "minLength": 2,
      "maxLength": 64
    },
    "display_name": { "type": "string", "minLength": 1, "maxLength": 64 },
    "description": { "type": "string", "maxLength": 400 },
    "source_intent_ref": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "contract": { "$ref": "#/$defs/ContractSpec" },
    "subjects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/SubjectSpec" }
    },
    "spatial": {
      "type": "array",
      "minItems": 0,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/SpatialSpec" }
    },
    "relations": {
      "type": "array",
      "minItems": 0,
      "maxItems": 12,
      "items": { "$ref": "#/$defs/RelationSpec" }
    },
    "process_graph": { "$ref": "#/$defs/ProcessGraphSpec" },
    "expression": { "$ref": "#/$defs/ExpressionSpec" },
    "budget": { "$ref": "#/$defs/BudgetSpec" }
  },
  "$defs": {
    "ContractSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timing", "combat"],
      "properties": {
        "timing": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "windup_s",
            "full_charge_s",
            "recovery_s",
            "max_active_duration_s"
          ],
          "properties": {
            "windup_s": { "type": "number", "minimum": 0.0, "maximum": 3.0 },
            "full_charge_s": { "type": "number", "minimum": 0.0, "maximum": 10.0 },
            "recovery_s": { "type": "number", "minimum": 0.0, "maximum": 3.0 },
            "max_active_duration_s": { "type": "number", "exclusiveMinimum": 0.0, "maximum": 30.0 }
          }
        },
        "combat": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "formation_mode",
            "min_deliverable_progress",
            "caster_mobility",
            "targeting",
            "range_m",
            "release_policy",
            "interruption_policy",
            "control_focus",
            "provider"
          ],
          "properties": {
            "formation_mode": {
              "type": "string",
              "enum": ["INSTANT", "GRADUAL_CHARGE", "SUSTAINED_CHANNEL", "VESSEL_IMPRINT"]
            },
            "min_deliverable_progress": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
            "charge_tiers": {
              "type": "array",
              "minItems": 0,
              "maxItems": 3,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["min_progress", "scale_mul", "intensity_mul", "cost_mul"],
                "properties": {
                  "min_progress": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
                  "scale_mul": { "type": "number", "exclusiveMinimum": 0.0, "maximum": 3.0 },
                  "intensity_mul": { "type": "number", "exclusiveMinimum": 0.0, "maximum": 3.0 },
                  "cost_mul": { "type": "number", "exclusiveMinimum": 0.0, "maximum": 3.0 }
                }
              }
            },
            "caster_mobility": {
              "type": "string",
              "enum": ["FREE_MOVE", "SLOW_WALK", "ROOTED"]
            },
            "targeting": {
              "type": "string",
              "enum": ["POINT", "DIRECTION", "SELF_OR_ANCHOR", "LOCKED_ACTOR", "VESSEL_TOUCH"]
            },
            "range_m": { "type": "number", "minimum": 0.0, "maximum": 40.0 },
            "release_policy": {
              "type": "object",
              "additionalProperties": false,
              "required": ["on_valid_release", "on_under_threshold_release"],
              "properties": {
                "on_valid_release": {
                  "type": "string",
                  "enum": ["DELIVER_OR_HANDOFF", "DISSIPATE"]
                },
                "on_under_threshold_release": {
                  "type": "string",
                  "enum": ["FIZZLE_PARTIAL_REFUND", "CONVERT_TO_SMALL_INSTANT", "NONE"]
                }
              }
            },
            "interruption_policy": {
              "type": "object",
              "additionalProperties": false,
              "required": ["on_interrupt", "dodge_behavior", "interruption_priority"],
              "properties": {
                "on_interrupt": {
                  "type": "string",
                  "enum": ["ABORT_AND_DROP", "COLLAPSE_IN_PLACE", "COMMIT_IF_PAST_THRESHOLD"]
                },
                "dodge_behavior": {
                  "type": "string",
                  "enum": ["TRIGGER_INTERRUPT", "ALLOW_DODGE_AFTER_HANDOFF"]
                },
                "interruption_priority": {
                  "type": "string",
                  "enum": ["INTERRUPT_WINS_UNLESS_COMMITTED", "INTERRUPT_ALWAYS_WINS"]
                }
              }
            },
            "control_focus": {
              "type": "object",
              "additionalProperties": false,
              "required": ["owner", "exclusive_focus_slot"],
              "properties": {
                "owner": {
                  "type": "string",
                  "enum": ["CASTER_FOCUS", "AUTONOMOUS", "VESSEL_BOUND"]
                },
                "exclusive_focus_slot": { "type": "boolean" }
              }
            },
            "provider": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "energy_source",
                "post_release_reserve_mana",
                "max_upfront_mana",
                "max_sustain_mana_per_s"
              ],
              "properties": {
                "energy_source": {
                  "type": "string",
                  "enum": [
                    "CASTER_MANA",
                    "POST_RELEASE_RESERVE",
                    "ENVIRONMENT_HARVEST",
                    "VESSEL_RESERVE"
                  ]
                },
                "post_release_reserve_mana": { "type": "number", "minimum": 0.0, "maximum": 200.0 },
                "max_upfront_mana": { "type": "number", "exclusiveMinimum": 0.0, "maximum": 300.0 },
                "max_sustain_mana_per_s": { "type": "number", "minimum": 0.0, "maximum": 60.0 }
              }
            }
          }
        }
      }
    },

    "ArtOverridesSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tint_palette"],
      "properties": {
        "contour_override": {
          "type": "string",
          "enum": [
            "SCULPTED_CORE",
            "FACETED_PRISM",
            "CONTINUOUS_RIBBON",
            "BRANCH_TENDRIL",
            "PLANAR_SIGIL",
            "VOLUMETRIC_MIST",
            "FIELD_AURA_RING"
          ]
        },
        "surface_override": {
          "type": "string",
          "enum": [
            "REFRACTIVE_LIQUID",
            "CRYSTALLINE_ICE",
            "ROUGH_STONE",
            "CONDUCTIVE_ARC",
            "GRAVITY_DISTORTION",
            "LIGHT_ABSORB_VOID",
            "THERMAL_FROST",
            "THERMAL_EMBER",
            "RUNIC_BARRIER_GLASS"
          ]
        },
        "secondary_additions": {
          "type": "array",
          "minItems": 0,
          "maxItems": 3,
          "items": {
            "type": "string",
            "enum": [
              "VELOCITY_FOAM",
              "STRESS_CRACKS",
              "FROST_CREEP_DECAL",
              "CRATER_DECAL",
              "SCORCH_DECAL",
              "FLOATING_DUST",
              "ARC_SPARKS",
              "SONAR_RIPPLES"
            ]
          }
        },
        "tint_palette": {
          "type": "object",
          "additionalProperties": false,
          "required": ["primary_hex", "accent_hex", "emissive_boost"],
          "properties": {
            "primary_hex": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
            "accent_hex": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
            "emissive_boost": { "type": "number", "minimum": 0.0, "maximum": 5.0 }
          }
        }
      }
    },

    "InteractionProfile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "accepts_world_thermal": { "const": true },
        "accepts_world_conduction": { "const": true },
        "structural_fragility": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "buoyancy_class": { "type": "string", "enum": ["NEUTRAL", "HEAVY", "LIGHT"] }
      }
    },

    "BarrierPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["directional_one_way", "response_mode", "deflect_angle_deg"],
      "properties": {
        "directional_one_way": { "type": "boolean" },
        "response_mode": { "type": "string", "enum": ["BLOCK", "REFLECT", "DEFLECT"] },
        "deflect_angle_deg": { "type": "number", "minimum": 0.0, "maximum": 90.0 }
      }
    },

    "MaterialSubject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "material_id",
        "initial_phase",
        "capacity_mu",
        "initial_inventory_mu",
        "inherit_world_law",
        "art_overrides"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$" },
        "kind": { "const": "MATERIAL" },
        "material_id": {
          "type": "string",
          "enum": [
            "WATER",
            "ICE",
            "STONE",
            "METAL",
            "FOG",
            "FLAME",
            "ASH",
            "LIGHTNING_PLASMA",
            "VITAL_SPORE"
          ]
        },
        "initial_phase": {
          "type": "string",
          "enum": ["SOLID", "LIQUID", "GAS_MIST", "PLASMA"]
        },
        "capacity_mu": { "type": "number", "exclusiveMinimum": 0.0, "maximum": 1000.0 },
        "initial_inventory_mu": { "type": "number", "minimum": 0.0, "maximum": 1000.0 },
        "inherit_world_law": { "const": true },
        "art_overrides": { "$ref": "#/$defs/ArtOverridesSpec" },
        "interaction_profile": { "$ref": "#/$defs/InteractionProfile" }
      },
      "allOf": [
        {
          "if": { "required": ["material_id"], "properties": { "material_id": { "const": "WATER" } } },
          "then": { "properties": { "initial_phase": { "const": "LIQUID" } } }
        },
        {
          "if": { "required": ["material_id"], "properties": { "material_id": { "const": "ICE" } } },
          "then": { "properties": { "initial_phase": { "const": "SOLID" } } }
        },
        {
          "if": { "required": ["material_id"], "properties": { "material_id": { "const": "STONE" } } },
          "then": { "properties": { "initial_phase": { "const": "SOLID" } } }
        },
        {
          "if": { "required": ["material_id"], "properties": { "material_id": { "const": "METAL" } } },
          "then": { "properties": { "initial_phase": { "const": "SOLID" } } }
        },
        {
          "if": { "required": ["material_id"], "properties": { "material_id": { "const": "FOG" } } },
          "then": { "properties": { "initial_phase": { "const": "GAS_MIST" } } }
        },
        {
          "if": { "required": ["material_id"], "properties": { "material_id": { "const": "FLAME" } } },
          "then": { "properties": { "initial_phase": { "const": "PLASMA" } } }
        },
        {
          "if": { "required": ["material_id"], "properties": { "material_id": { "const": "LIGHTNING_PLASMA" } } },
          "then": { "properties": { "initial_phase": { "const": "PLASMA" } } }
        },
        {
          "if": { "required": ["material_id"], "properties": { "material_id": { "const": "ASH" } } },
          "then": { "properties": { "initial_phase": { "enum": ["SOLID", "GAS_MIST"] } } }
        },
        {
          "if": { "required": ["material_id"], "properties": { "material_id": { "const": "VITAL_SPORE" } } },
          "then": { "properties": { "initial_phase": { "enum": ["SOLID", "GAS_MIST"] } } }
        }
      ]
    },

    "FieldSubject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "field_channel",
        "initial_intensity",
        "max_intensity",
        "inherit_world_law",
        "art_overrides"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$" },
        "kind": { "const": "FIELD" },
        "field_channel": {
          "type": "string",
          "enum": [
            "GRAVITY",
            "HEAT_EXTRACTION",
            "HEAT_INJECTION",
            "LIGHT_EMISSION",
            "LIGHT_ATTENUATION",
            "WIND_FORCE",
            "ELECTRIC_POTENTIAL",
            "SPATIAL_BARRIER",
            "LOCAL_TIME_RATE",
            "VITAL_FLUX"
          ]
        },
        "initial_intensity": { "type": "number", "minimum": 0.0, "maximum": 500.0 },
        "max_intensity": { "type": "number", "exclusiveMinimum": 0.0, "maximum": 500.0 },
        "inherit_world_law": { "const": true },
        "art_overrides": { "$ref": "#/$defs/ArtOverridesSpec" },
        "interaction_profile": { "$ref": "#/$defs/InteractionProfile" },
        "barrier_policy": { "$ref": "#/$defs/BarrierPolicy" }
      },
      "if": {
        "required": ["field_channel"],
        "properties": { "field_channel": { "const": "SPATIAL_BARRIER" } }
      },
      "then": { "required": ["barrier_policy"] },
      "else": { "not": { "required": ["barrier_policy"] } }
    },

    "WorldRefSubject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "query_kind",
        "expected_filter",
        "require_existing"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$" },
        "kind": { "const": "WORLD_REF" },
        "query_kind": {
          "type": "string",
          "enum": ["VESSEL_IN_HAND", "TARGET_SURFACE", "NEARBY_MEDIUM", "LOCKED_ACTOR"]
        },
        "expected_filter": { "type": "string", "minLength": 1, "maxLength": 64 },
        "require_existing": { "type": "boolean" },
        "art_overrides": { "$ref": "#/$defs/ArtOverridesSpec" }
      }
    },

    "SubjectSpec": {
      "oneOf": [
        { "$ref": "#/$defs/MaterialSubject" },
        { "$ref": "#/$defs/FieldSubject" },
        { "$ref": "#/$defs/WorldRefSubject" }
      ]
    },

    "CurveProfileSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["curve", "domain", "min_val", "max_val"],
      "properties": {
        "curve": {
          "type": "string",
          "enum": [
            "CONSTANT",
            "LINEAR",
            "SLOW_BUILD",
            "FAST_ESTABLISH",
            "BELL_CONCENTRATED",
            "DECAY_OUT"
          ]
        },
        "domain": {
          "type": "string",
          "enum": ["PATH_U", "RADIAL_R", "SURFACE_UV"]
        },
        "min_val": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "max_val": { "type": "number", "minimum": 0.0, "maximum": 2.0 }
      }
    },

    "SpawnReferenceSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spawn_anchor"],
      "properties": {
        "spawn_anchor": {
          "type": "string",
          "enum": [
            "WORLD_POINT",
            "CASTER_BODY",
            "CASTER_HAND",
            "AIM_POINT",
            "AIM_DIRECTION",
            "LOCKED_TARGET",
            "AUTO_SUPPORT_SURFACE",
            "SUBJECT_ORIGIN",
            "WORLD_REF"
          ]
        },
        "spawn_subject_id": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$" },
        "spawn_offset_m": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "type": "number", "minimum": -30.0, "maximum": 30.0 }
        },
        "auto_support_rule": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_count", "max_distance_m", "surface_filter"],
          "properties": {
            "max_count": { "type": "integer", "minimum": 1, "maximum": 8 },
            "max_distance_m": { "type": "number", "exclusiveMinimum": 0.0, "maximum": 20.0 },
            "surface_filter": { "type": "string", "minLength": 1, "maxLength": 64 }
          }
        }
      }
    },

    "BodySpatialSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "subject_id",
        "carrier",
        "dimension",
        "generator",
        "node_budget",
        "edge_budget",
        "quad_budget",
        "max_deflect_iterations_per_node",
        "initial_extent_m",
        "distribution",
        "reference"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$" },
        "subject_id": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$" },
        "carrier": { "const": "BODY" },
        "dimension": { "const": "3D" },
        "generator": {
          "type": "string",
          "enum": ["SPHERE_SCULPT", "LANCE_PRISM", "SLAB_MONOLITH", "COMPOUND_FROM_PATH"]
        },
        "node_budget": { "const": 0 },
        "edge_budget": { "const": 0 },
        "quad_budget": { "const": 0 },
        "max_deflect_iterations_per_node": { "const": 0 },
        "initial_extent_m": { "type": "number", "minimum": 0.1, "maximum": 12.0 },
        "distribution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cross_section", "aspect_ratio", "surface_roughness"],
          "properties": {
            "cross_section": { "type": "string", "enum": ["CIRCULAR", "PRISM", "SLAB"] },
            "aspect_ratio": { "type": "number", "minimum": 0.2, "maximum": 5.0 },
            "surface_roughness": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
          }
        },
        "reference": { "$ref": "#/$defs/SpawnReferenceSpec" }
      }
    },

    "PathGraphSpatialSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "subject_id",
        "carrier",
        "dimension",
        "generator",
        "node_budget",
        "edge_budget",
        "quad_budget",
        "max_deflect_iterations_per_node",
        "per_segment_phase",
        "initial_extent_m",
        "distribution",
        "reference"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$" },
        "subject_id": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$" },
        "carrier": { "const": "PATH_GRAPH" },
        "dimension": { "const": "1D" },
        "generator": {
          "type": "string",
          "enum": ["LINE_SEGMENT", "ARC_CURVE", "BRANCH_WEB", "CLOSED_RING"]
        },
        "node_budget": { "type": "integer", "minimum": 2, "maximum": 16 },
        "edge_budget": { "type": "integer", "minimum": 1, "maximum": 24 },
        "quad_budget": { "const": 0 },
        "max_deflect_iterations_per_node": { "type": "integer", "minimum": 0, "maximum": 2 },
        "per_segment_phase": { "type": "boolean" },
        "initial_extent_m": { "type": "number", "minimum": 0.2, "maximum": 20.0 },
        "distribution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width_m", "thickness_m", "width_profile", "on_obstruction"],
          "properties": {
            "width_m": { "type": "number", "minimum": 0.02, "maximum": 3.0 },
            "thickness_m": { "type": "number", "minimum": 0.02, "maximum": 3.0 },
            "width_profile": { "$ref": "#/$defs/CurveProfileSpec" },
            "on_obstruction": {
              "type": "string",
              "enum": ["DEFORM_OR_TRUNCATE", "SLIDE_BOUNDARY", "HALT"]
            }
          }
        },
        "reference": { "$ref": "#/$defs/SpawnReferenceSpec" }
      }
    },

    "SurfaceSpatialSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "subject_id",
        "carrier",
        "dimension",
        "generator",
        "node_budget",
        "edge_budget",
        "quad_budget",
        "max_deflect_iterations_per_node",
        "initial_extent_m",
        "distribution",
        "reference"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$" },
        "subject_id": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$" },
        "carrier": { "const": "SURFACE" },
        "dimension": { "const": "2D" },
        "generator": {
          "type": "string",
          "enum": ["BOUNDED_PLANE", "SWEPT_STRIP", "CONFORMAL_SHELL"]
        },
        "node_budget": { "const": 0 },
        "edge_budget": { "const": 0 },
        "quad_budget": { "type": "integer", "minimum": 1, "maximum": 64 },
        "max_deflect_iterations_per_node": { "type": "integer", "minimum": 0, "maximum": 1 },
        "initial_extent_m": { "type": "number", "minimum": 0.2, "maximum": 12.0 },
        "distribution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["thickness_m", "boundary_falloff", "edge_profile"],
          "properties": {
            "thickness_m": { "type": "number", "minimum": 0.01, "maximum": 1.5 },
            "boundary_falloff": { "type": "string", "enum": ["SHARP", "FEATHERED"] },
            "edge_profile": { "$ref": "#/$defs/CurveProfileSpec" }
          }
        },
        "reference": { "$ref": "#/$defs/SpawnReferenceSpec" }
      }
    },

    "RegionSpatialSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "subject_id",
        "carrier",
        "dimension",
        "generator",
        "node_budget",
        "edge_budget",
        "quad_budget",
        "max_deflect_iterations_per_node",
        "initial_extent_m",
        "distribution",
        "reference"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$" },
        "subject_id": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$" },
        "carrier": { "const": "REGION" },
        "dimension": { "const": "3D" },
        "generator": {
          "type": "string",
          "enum": ["RADIAL_SPHERE", "CYLINDER_COLUMN", "CONE_SECTOR", "ALIGNED_BOX"]
        },
        "node_budget": { "const": 0 },
        "edge_budget": { "const": 0 },
        "quad_budget": { "const": 0 },
        "max_deflect_iterations_per_node": { "const": 0 },
        "initial_extent_m": { "type": "number", "minimum": 0.2, "maximum": 16.0 },
        "distribution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["radial_falloff", "boundary"],
          "properties": {
            "radial_falloff": {
              "type": "string",
              "enum": ["CONSTANT", "LINEAR_DECAY", "BELL_CONCENTRATED", "INVERSE_EDGE"]
            },
            "boundary": { "type": "string", "enum": ["SHARP", "SOFT"] }
          }
        },
        "reference": { "$ref": "#/$defs/SpawnReferenceSpec" }
      }
    },

    "SpatialSpec": {
      "oneOf": [
        { "$ref": "#/$defs/BodySpatialSpec" },
        { "$ref": "#/$defs/PathGraphSpatialSpec" },
        { "$ref": "#/$defs/SurfaceSpatialSpec" },
        { "$ref": "#/$defs/RegionSpatialSpec" }
      ]
    },

    "RelationSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "source_ref", "target_ref", "channel"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$" },
        "kind": {
          "type": "string",
          "enum": ["SPATIAL_ATTACH", "FUNCTIONAL_COUPLE", "CONSTRAINT_LINK"]
        },
        "source_ref": { "type": "string", "minLength": 3, "maxLength": 64 },
        "target_ref": { "type": "string", "minLength": 3, "maxLength": 64 },
        "channel": {
          "type": "string",
          "enum": [
            "FOLLOW_TRANSFORM",
            "DISTURBANCE_TO_PERCEPTION",
            "ENERGY_FEED",
            "CONTACT_TO_TRIGGER",
            "GRAPH_SUPPORT"
          ]
        },
        "attach_mode": {
          "type": "string",
          "enum": ["RIGID_OFFSET", "SOFT_FOLLOW", "ORBIT_ANCHOR", "HAND_SOCKET", "MULTI_SUPPORT_ATTACH"]
        },
        "local_offset_m": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "type": "number", "minimum": -15.0, "maximum": 15.0 }
        },
        "signal_granularity": {
          "type": "string",
          "enum": ["BINARY_PING", "DIRECTIONAL_IMPULSE", "INTENSITY_SAMPLE"]
        },
        "max_distance_m": { "type": "number", "exclusiveMinimum": 0.0, "maximum": 30.0 }
      }
    },

    "DirectionSpec": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "axis"],
          "properties": {
            "mode": { "const": "WORLD_AXIS" },
            "axis": {
              "type": "string",
              "enum": ["POS_X", "NEG_X", "POS_Y", "NEG_Y", "POS_Z", "NEG_Z", "UP", "DOWN"]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "axis"],
          "properties": {
            "mode": { "const": "FRAME_RELATIVE" },
            "axis": {
              "type": "string",
              "enum": ["AIM_FORWARD", "CASTER_FORWARD", "SURFACE_NORMAL", "SURFACE_TANGENT"]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "center_ref", "polarity"],
          "properties": {
            "mode": { "const": "RADIAL" },
            "center_ref": { "type": "string", "minLength": 3, "maxLength": 64 },
            "polarity": { "type": "string", "enum": ["INWARD", "OUTWARD"] }
          }
        }
      ]
    },

    "PropagationSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain",
        "origin_ref",
        "speed_m_s",
        "max_reach_m",
        "attenuation",
        "connectivity_policy",
        "on_missing_origin"
      ],
      "properties": {
        "domain": {
          "type": "string",
          "enum": ["SPATIAL_RADIUS", "PATH_CONNECTIVITY", "SURFACE_SPREAD", "CONDUCTIVE_GRAPH"]
        },
        "origin_ref": { "type": "string", "minLength": 3, "maxLength": 64 },
        "speed_m_s": { "type": "number", "exclusiveMinimum": 0.0, "maximum": 120.0 },
        "max_reach_m": { "type": "number", "exclusiveMinimum": 0.0, "maximum": 30.0 },
        "max_hops": { "type": "integer", "minimum": 1, "maximum": 12 },
        "attenuation": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "connectivity_policy": {
          "type": "string",
          "enum": ["LIVE_CONNECTIVITY", "INITIAL_SNAPSHOT"]
        },
        "on_missing_origin": {
          "type": "string",
          "enum": ["FALLBACK_TO_ROOT_NODE", "ABORT_NO_COST"]
        }
      }
    },

    "OpEstablish": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "target_kind", "target_id"],
      "properties": {
        "op": { "const": "ESTABLISH" },
        "target_kind": { "type": "string", "enum": ["SUBJECT", "RELATION"] },
        "target_id": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$" },
        "handle_id": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$" }
      }
    },

    "OpDriveContinuous": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "target_subject_id", "channel", "mode", "magnitude", "profile"],
      "properties": {
        "op": { "const": "DRIVE" },
        "handle_id": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$" },
        "target_subject_id": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$" },
        "channel": {
          "type": "string",
          "enum": ["POSE", "EXTENT", "DISTRIBUTION", "FLOW", "INTENSITY", "DIRECTION"]
        },
        "mode": { "type": "string", "enum": ["TARGET", "RATE"] },
        "magnitude": { "type": "number", "minimum": -500.0, "maximum": 500.0 },
        "direction": { "$ref": "#/$defs/DirectionSpec" },
        "target_ref": { "type": "string", "minLength": 3, "maxLength": 64 },
        "profile": {
          "type": "string",
          "enum": ["CONSTANT", "LINEAR_RAMP", "EASE_IN_OUT", "PULSE"]
        },
        "propagation": { "$ref": "#/$defs/PropagationSpec" }
      }
    },

    "OpDriveImpulse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "target_subject_id",
        "channel",
        "mode",
        "magnitude",
        "direction",
        "profile"
      ],
      "properties": {
        "op": { "const": "DRIVE" },
        "target_subject_id": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$" },
        "channel": {
          "type": "string",
          "enum": ["VELOCITY_IMPULSE", "INTENSITY_BURST"]
        },
        "mode": { "const": "IMPULSE" },
        "magnitude": { "type": "number", "exclusiveMinimum": 0.0, "maximum": 500.0 },
        "direction": { "$ref": "#/$defs/DirectionSpec" },
        "profile": {
          "type": "string",
          "enum": ["INSTANT_BURST", "DECAY_BURST"]
        },
        "propagation": { "$ref": "#/$defs/PropagationSpec" }
      }
    },

    "OpConstrain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "handle_id",
        "target_subject_id",
        "constraint_family",
        "desired_value",
        "tolerance",
        "capacity_lu",
        "rebind_cooldown_s",
        "on_exceed",
        "provider_ref"
      ],
      "properties": {
        "op": { "const": "CONSTRAIN" },
        "handle_id": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$" },
        "target_subject_id": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$" },
        "constraint_family": {
          "type": "string",
          "enum": ["PIN", "TETHER", "CONTAIN", "AXIS_LOCK", "PRESSURE_WALL", "COHESION", "SUPPORT"]
        },
        "anchor_ref": { "type": "string", "minLength": 3, "maxLength": 64 },
        "desired_value": { "type": "number", "minimum": -100.0, "maximum": 500.0 },
        "tolerance": { "type": "number", "minimum": 0.0, "maximum": 100.0 },
        "capacity_lu": { "type": "number", "exclusiveMinimum": 0.0, "maximum": 500.0 },
        "rebind_cooldown_s": { "type": "number", "minimum": 0.05, "maximum": 10.0 },
        "on_exceed": {
          "type": "string",
          "enum": ["DETACH", "FRACTURE", "VENT", "STALL_NOTIFY", "DEFORM", "YIELD"]
        },
        "provider_ref": {
          "type": "string",
          "enum": ["CASTER_MANA", "POST_RELEASE_RESERVE", "VESSEL_RESERVE", "PASSIVE_STRUCTURE"]
        }
      }
    },

    "OpTransform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "target_subject_id", "transform_id", "preserve"],
      "properties": {
        "op": { "const": "TRANSFORM" },
        "target_subject_id": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$" },
        "transform_id": {
          "type": "string",
          "enum": [
            "PHASE_CHANGE",
            "STRUCTURAL_CRYSTALLIZE",
            "SUBDIVIDE",
            "MERGE",
            "IONIZE_OR_IGNITE",
            "IGNITE_EXOTHERMIC",
            "DISSIPATE"
          ]
        },
        "preserve": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "type": "string",
            "enum": ["MASS", "TOPOLOGY", "MOMENTUM", "TEMPERATURE", "HEAT", "POSITION"]
          }
        },
        "target_phase": {
          "type": "string",
          "enum": ["SOLID", "LIQUID", "GAS_MIST", "PLASMA"]
        },
        "max_output_bodies": { "type": "integer", "minimum": 1, "maximum": 16 },
        "propagation": { "$ref": "#/$defs/PropagationSpec" }
      }
    },

    "OpTransfer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "source_ref",
        "target_subject_id",
        "resource_kind",
        "rate_per_s",
        "max_amount",
        "on_insufficient_source"
      ],
      "properties": {
        "op": { "const": "TRANSFER" },
        "source_ref": { "type": "string", "minLength": 3, "maxLength": 64 },
        "target_subject_id": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$" },
        "resource_kind": { "type": "string", "enum": ["MU", "EU", "LU", "HEAT"] },
        "rate_per_s": { "type": "number", "exclusiveMinimum": 0.0, "maximum": 500.0 },
        "max_amount": { "type": "number", "exclusiveMinimum": 0.0, "maximum": 1000.0 },
        "on_insufficient_source": {
          "type": "string",
          "enum": ["CLAMP_TO_AVAILABLE", "PAUSE_PROCESS", "ABORT_OP"]
        },
        "propagation": { "$ref": "#/$defs/PropagationSpec" }
      }
    },

    "OpCouple": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "handle_id", "relation_id"],
      "properties": {
        "op": { "const": "COUPLE" },
        "handle_id": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$" },
        "relation_id": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$" }
      }
    },

    "OpWithdraw": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "target_scope", "mode"],
      "properties": {
        "op": { "const": "WITHDRAW" },
        "target_scope": {
          "type": "string",
          "enum": ["HANDLE", "SUBJECT_SUPPORTS", "ALL_SPELL_SUPPORTS"]
        },
        "target_id": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$" },
        "mode": {
          "type": "string",
          "enum": ["DISSIPATE", "NATURAL_RELEASE", "RECLAIM_TO_CASTER"]
        }
      }
    },

    "OnEnterOpSpec": {
      "oneOf": [
        { "$ref": "#/$defs/OpEstablish" },
        { "$ref": "#/$defs/OpDriveContinuous" },
        { "$ref": "#/$defs/OpDriveImpulse" },
        { "$ref": "#/$defs/OpConstrain" },
        { "$ref": "#/$defs/OpTransform" },
        { "$ref": "#/$defs/OpTransfer" },
        { "$ref": "#/$defs/OpCouple" },
        { "$ref": "#/$defs/OpWithdraw" }
      ]
    },

    "WhileActiveOpSpec": {
      "oneOf": [
        { "$ref": "#/$defs/OpDriveContinuous" },
        { "$ref": "#/$defs/OpConstrain" },
        { "$ref": "#/$defs/OpTransfer" },
        { "$ref": "#/$defs/OpCouple" },
        { "$ref": "#/$defs/OpWithdraw" }
      ]
    },

    "OnExitOpSpec": {
      "oneOf": [
        { "$ref": "#/$defs/OpDriveImpulse" },
        { "$ref": "#/$defs/OpTransform" },
        { "$ref": "#/$defs/OpTransfer" },
        { "$ref": "#/$defs/OpWithdraw" }
      ]
    },

    "TransitionSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "on_event",
        "event_source_filter",
        "next_process_ids",
        "handoff_handles",
        "action"
      ],
      "properties": {
        "on_event": {
          "type": "string",
          "enum": [
            "ON_SPAWN",
            "ON_INPUT_RELEASE",
            "ON_INPUT_HOLD_EXPIRE",
            "ON_INTERRUPT",
            "ON_TIMEOUT",
            "ON_COLLIDE",
            "ON_CONSTRAINT_EXCEEDED",
            "ON_GRAPH_COMPLETED",
            "ON_PHASE_CHANGED",
            "ON_DEPLETED",
            "ON_DISTURBANCE_PING"
          ]
        },
        "event_source_filter": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scope"],
          "properties": {
            "scope": {
              "type": "string",
              "enum": ["SELF_PROCESS", "SUBJECT", "CAST_INSTANCE"]
            },
            "subject_id": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$" }
          }
        },
        "next_process_ids": {
          "type": "array",
          "maxItems": 4,
          "items": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$" }
        },
        "handoff_handles": {
          "type": "array",
          "maxItems": 8,
          "items": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$" }
        },
        "action": {
          "type": "string",
          "enum": [
            "STOP_SELF_START_NEXT",
            "KEEP_SELF_START_NEXT",
            "STOP_SELF_ONLY",
            "HANDOFF_TO_RESERVE"
          ]
        }
      }
    },

    "ProcessSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "role",
        "on_enter",
        "while_active",
        "on_exit",
        "max_duration_s",
        "transitions"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$" },
        "role": {
          "type": "string",
          "enum": [
            "GENESIS",
            "CARRIER_EXECUTION",
            "CONSTRAINT_HOLD",
            "TRANSFORM_STAGE",
            "TRIGGER_WATCH",
            "CLEANUP_DISSIPATE"
          ]
        },
        "on_enter": {
          "type": "array",
          "maxItems": 12,
          "items": { "$ref": "#/$defs/OnEnterOpSpec" }
        },
        "while_active": {
          "type": "array",
          "maxItems": 12,
          "items": { "$ref": "#/$defs/WhileActiveOpSpec" }
        },
        "on_exit": {
          "type": "array",
          "maxItems": 12,
          "items": { "$ref": "#/$defs/OnExitOpSpec" }
        },
        "max_duration_s": { "type": "number", "exclusiveMinimum": 0.0, "maximum": 30.0 },
        "transitions": {
          "type": "array",
          "maxItems": 8,
          "items": { "$ref": "#/$defs/TransitionSpec" }
        }
      }
    },

    "ProcessGraphSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry_processes", "processes"],
      "properties": {
        "entry_processes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$" }
        },
        "processes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/ProcessSpec" }
        }
      }
    },

    "ExpressionSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "caster_cue",
        "omen_profile",
        "audio_profile",
        "aftermath_profile",
        "camera_impulse_level"
      ],
      "properties": {
        "caster_cue": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pose_tag", "cast_focus_ms"],
          "properties": {
            "pose_tag": {
              "type": "string",
              "enum": [
                "STAFF_RAISE",
                "STAFF_SWEEP",
                "PALM_PLANT",
                "TWO_HAND_CONDENSE",
                "VESSEL_ETCH",
                "FINGER_SNAP",
                "NONE"
              ]
            },
            "cast_focus_ms": { "type": "integer", "minimum": 0, "maximum": 2000 }
          }
        },
        "omen_profile": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sky_darken",
            "ambient_fog_tint_strength",
            "environment_resonates",
            "omitted_during_instant_cast"
          ],
          "properties": {
            "sky_darken": { "type": "number", "minimum": 0.0, "maximum": 0.7 },
            "ambient_fog_tint_strength": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
            "environment_resonates": { "type": "boolean" },
            "omitted_during_instant_cast": { "type": "boolean" }
          }
        },
        "audio_profile": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "drone_module",
            "impact_module",
            "sustain_loop_module",
            "pre_delivery_silence_ms"
          ],
          "properties": {
            "drone_module": {
              "type": "string",
              "enum": [
                "NONE",
                "CRYSTALLINE_HUM",
                "SUB_VOID_RUMBLE",
                "ARC_CRACKLE_HUM",
                "HOLLOW_WIND",
                "RESONANT_CHORD"
              ]
            },
            "impact_module": {
              "type": "string",
              "enum": [
                "NONE",
                "ICE_LOCK_CRACK",
                "TECTONIC_SLAM",
                "THUNDER_CRACK",
                "HARMONIC_DEFLECT",
                "FROST_SHATTER",
                "ETHER_PING"
              ]
            },
            "sustain_loop_module": {
              "type": "string",
              "enum": [
                "NONE",
                "TENSE_WATER_STRAIN",
                "SILENT_PRESSURE_HUM",
                "SOFT_MIST_AMBIENCE",
                "BARRIER_STRAIN_CHIME",
                "ARC_HOLD_BUZZ"
              ]
            },
            "pre_delivery_silence_ms": { "type": "integer", "minimum": 0, "maximum": 120 }
          }
        },
        "aftermath_profile": {
          "type": "object",
          "additionalProperties": false,
          "required": ["light_decay_s", "leave_world_scars", "hitstop_local_ms"],
          "properties": {
            "light_decay_s": { "type": "number", "minimum": 0.0, "maximum": 5.0 },
            "leave_world_scars": { "type": "boolean" },
            "hitstop_local_ms": { "type": "integer", "minimum": 0, "maximum": 140 }
          }
        },
        "camera_impulse_level": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
      }
    },

    "BudgetSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compiler_status",
        "peak_dynamic_bodies",
        "peak_path_nodes",
        "peak_surface_quads",
        "peak_point_lights",
        "derived_upfront_mana",
        "derived_sustain_mana_per_s",
        "derived_reserve_mana",
        "estimated_tick_cost_us"
      ],
      "properties": {
        "compiler_status": { "const": "VALID" },
        "peak_dynamic_bodies": { "type": "integer", "minimum": 0, "maximum": 16 },
        "peak_path_nodes": { "type": "integer", "minimum": 0, "maximum": 16 },
        "peak_surface_quads": { "type": "integer", "minimum": 0, "maximum": 64 },
        "peak_point_lights": { "type": "integer", "minimum": 0, "maximum": 3 },
        "derived_upfront_mana": { "type": "number", "exclusiveMinimum": 0.0, "maximum": 300.0 },
        "derived_sustain_mana_per_s": { "type": "number", "minimum": 0.0, "maximum": 60.0 },
        "derived_reserve_mana": { "type": "number", "minimum": 0.0, "maximum": 200.0 },
        "estimated_tick_cost_us": { "type": "integer", "minimum": 1, "maximum": 300 }
      }
    }
  }
}
