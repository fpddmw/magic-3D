{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fpddmw/magic-3D/schemas/magic_dsl_v0_2.schema.json",
  "title": "CompiledSpellDSL v0.2",
  "description": "Strict machine-verifiable schema for Magic DSL v0.2 compiled spell definitions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "meta",
    "subjects",
    "spatial",
    "relations",
    "processes",
    "contract",
    "expression",
    "budget"
  ],
  "properties": {
    "schema_version": { "const": "0.2" },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "display_name", "rune_signature", "intent_summary", "world_law_version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "display_name": { "type": "string", "minLength": 1 },
        "rune_signature": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "intent_summary": { "type": "string", "minLength": 1 },
        "world_law_version": { "const": "0.2" }
      }
    },
    "subjects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/SubjectSpec" }
    },
    "spatial": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/SpatialSpec" }
    },
    "relations": {
      "type": "array",
      "maxItems": 16,
      "items": { "$ref": "#/$defs/RelationSpec" }
    },
    "processes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/ProcessSpec" }
    },
    "contract": { "$ref": "#/$defs/ContractSpec" },
    "expression": { "$ref": "#/$defs/ExpressionSpec" },
    "budget": { "$ref": "#/$defs/BudgetSpec" }
  },
  "$defs": {
    "EventType": {
      "type": "string",
      "enum": [
        "RELEASE",
        "INTERRUPT",
        "DEPLETED",
        "CONTACT_ENTER",
        "OBSTRUCTION",
        "BROKEN",
        "COMPLETED",
        "TIMER",
        "DISTURBANCE"
      ]
    },
    "InteractionChannel": {
      "type": "string",
      "enum": [
        "MECHANICAL",
        "MATERIAL",
        "THERMAL",
        "CONDUCTIVE",
        "OPTICAL",
        "INFORMATIONAL",
        "SPATIAL",
        "TEMPORAL"
      ]
    },
    "ProfileSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["curve", "domain", "min_val", "max_val", "inverted"],
      "properties": {
        "curve": {
          "type": "string",
          "enum": [
            "CONSTANT",
            "LINEAR",
            "SLOW_BUILD",
            "FAST_ESTABLISH",
            "BELL_CONCENTRATED",
            "IMPULSE_SPIKE",
            "DECAY_OUT",
            "PIECEWISE_4PT"
          ]
        },
        "domain": {
          "type": "string",
          "enum": ["TIME_NORM", "PATH_U", "RADIAL_R", "CHARGE_PROGRESS", "LOAD_RATIO"]
        },
        "min_val": { "type": "number" },
        "max_val": { "type": "number" },
        "inverted": { "type": "boolean" },
        "control_points": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
        }
      }
    },
    "PropagationSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain", "origin_ref", "speed_m_s", "max_reach_m", "reserve_ref"],
      "properties": {
        "domain": {
          "type": "string",
          "enum": ["SPATIAL_RADIUS", "PATH_CONNECTIVITY", "CONDUCTIVE_GRAPH"]
        },
        "origin_ref": { "type": "string", "minLength": 1 },
        "speed_m_s": { "type": "number", "exclusiveMinimum": 0.0 },
        "max_reach_m": { "type": "number", "exclusiveMinimum": 0.0 },
        "reserve_ref": {
          "type": "string",
          "enum": ["CASTER_MANA", "POST_RELEASE_RESERVE", "VESSEL_RESERVE"]
        }
      }
    },
    "SubjectSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "material_id",
        "initial_phase",
        "field_channel",
        "initial_quantity",
        "inherit_world_law",
        "overrides"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "enum": ["MATERIAL", "FIELD", "RELATION"] },
        "material_id": {
          "type": ["string", "null"],
          "enum": [
            null,
            "WATER",
            "ICE",
            "STONE",
            "METAL",
            "FOG",
            "FLAME",
            "ASH",
            "LIGHTNING_PLASMA",
            "VITAL_SPORE"
          ]
        },
        "initial_phase": {
          "type": ["string", "null"],
          "enum": [null, "SOLID", "LIQUID", "GAS_MIST", "PLASMA"]
        },
        "field_channel": {
          "type": ["string", "null"],
          "enum": [
            null,
            "GRAVITY",
            "HEAT_EXTRACTION",
            "HEAT_INJECTION",
            "LIGHT_EMISSION",
            "LIGHT_ATTENUATION",
            "WIND_FORCE",
            "ELECTRIC_POTENTIAL",
            "SPATIAL_BARRIER",
            "LOCAL_TIME_RATE",
            "VITAL_FLUX"
          ]
        },
        "initial_quantity": { "type": "number", "minimum": 0.0 },
        "inherit_world_law": { "type": "boolean" },
        "interaction_profile": {
          "type": "object",
          "additionalProperties": false,
          "required": ["hp_weight", "poise_weight", "impulse_weight", "mobility_constraint"],
          "properties": {
            "hp_weight": { "type": "number", "minimum": 0.0 },
            "poise_weight": { "type": "number", "minimum": 0.0 },
            "impulse_weight": { "type": "number", "minimum": 0.0 },
            "mobility_constraint": {
              "type": "string",
              "enum": ["NONE", "SLOW", "ROOT_TETHER", "ENCUMBER"]
            }
          }
        },
        "overrides": { "type": "object" }
      }
    },
    "AnchorRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "binding", "max_count", "max_distance_m"],
      "properties": {
        "source": {
          "type": "string",
          "enum": [
            "WORLD_POINT",
            "CASTER_BODY",
            "CASTER_HAND",
            "AIM_POINT",
            "AIM_DIRECTION",
            "LOCKED_TARGET",
            "AUTO_SUPPORT_SURFACE",
            "NEARBY_MEDIUM",
            "SUBJECT_REF",
            "ACTUAL_CONTACT_POINT"
          ]
        },
        "binding": { "type": "string", "enum": ["CAPTURE", "FOLLOW", "ATTACH", "CONTROL"] },
        "max_count": { "type": "integer", "minimum": 1, "maximum": 8 },
        "max_distance_m": { "type": "number", "minimum": 0.0 },
        "subject_ref": { "type": "string" }
      }
    },
    "SpatialSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject_id", "carrier", "reference", "geometry", "distribution", "connectivity"],
      "properties": {
        "subject_id": { "type": "string", "minLength": 1 },
        "carrier": { "type": "string", "enum": ["BODY", "PATH_GRAPH", "SURFACE", "REGION"] },
        "reference": {
          "type": "object",
          "additionalProperties": false,
          "required": ["anchor_source", "binding", "secondary_anchors", "frame"],
          "properties": {
            "anchor_source": {
              "type": "string",
              "enum": [
                "WORLD_POINT",
                "CASTER_BODY",
                "CASTER_HAND",
                "AIM_POINT",
                "AIM_DIRECTION",
                "LOCKED_TARGET",
                "AUTO_SUPPORT_SURFACE",
                "NEARBY_MEDIUM",
                "SUBJECT_REF",
                "ACTUAL_CONTACT_POINT"
              ]
            },
            "binding": { "type": "string", "enum": ["CAPTURE", "FOLLOW", "ATTACH", "CONTROL"] },
            "anchor_subject_id": { "type": "string" },
            "secondary_anchors": {
              "type": "array",
              "maxItems": 4,
              "items": { "$ref": "#/$defs/AnchorRef" }
            },
            "frame": {
              "type": "string",
              "enum": ["WORLD_FIXED", "FOLLOW_CASTER", "FOLLOW_TARGET", "ATTACHED_SUBJECT"]
            }
          }
        },
        "geometry": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "generator",
            "dimension",
            "extent_m",
            "thickness_m",
            "node_budget",
            "edge_budget",
            "quad_budget"
          ],
          "properties": {
            "generator": {
              "type": "string",
              "enum": [
                "SPHERE_SCULPT",
                "LANCE_PRISM",
                "SLAB_MONOLITH",
                "COMPOUND_FROM_PATH",
                "LINE_SEGMENT",
                "ARC_CURVE",
                "BRANCH_WEB",
                "CLOSED_RING",
                "BOUNDED_PLANE",
                "SWEPT_STRIP",
                "CONFORMAL_SHELL",
                "RADIAL_SPHERE",
                "CYLINDER_COLUMN",
                "CONE_SECTOR",
                "ALIGNED_BOX"
              ]
            },
            "dimension": { "type": "string", "enum": ["0D", "1D", "2D", "3D"] },
            "extent_m": { "type": "number", "exclusiveMinimum": 0.0 },
            "thickness_m": { "type": "number", "minimum": 0.0 },
            "node_budget": { "type": "integer", "minimum": 0, "maximum": 16 },
            "edge_budget": { "type": "integer", "minimum": 0, "maximum": 24 },
            "quad_budget": { "type": "integer", "minimum": 0, "maximum": 64 }
          }
        },
        "distribution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sampling", "boundary", "extent_profile", "density"],
          "properties": {
            "sampling": { "type": "string", "enum": ["CONTINUOUS", "DISCRETE", "DIFFUSE"] },
            "boundary": { "type": "string", "enum": ["SHARP", "FALLOFF"] },
            "extent_profile": { "$ref": "#/$defs/ProfileSpec" },
            "density": { "type": "number", "minimum": 0.0 }
          }
        },
        "connectivity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "allow_branching",
            "allow_loop_close",
            "allow_local_deformation",
            "max_deflect_iterations_per_node",
            "on_obstruction"
          ],
          "properties": {
            "allow_branching": { "type": "boolean" },
            "allow_loop_close": { "type": "boolean" },
            "allow_local_deformation": { "type": "boolean" },
            "max_deflect_iterations_per_node": { "type": "integer", "minimum": 0, "maximum": 2 },
            "on_obstruction": {
              "type": "string",
              "enum": ["DEFORM_OR_TRUNCATE", "SLIDE_BOUNDARY", "HALT", "PASS_THROUGH"]
            }
          }
        }
      }
    },
    "RelationSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "source_subject_id", "target_ref", "channel", "mode", "max_distance_m"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": {
          "type": "string",
          "enum": ["CONSTRAINT_RELATION", "FUNCTIONAL_LINK", "SPATIAL_ATTACHMENT"]
        },
        "source_subject_id": { "type": "string", "minLength": 1 },
        "target_ref": { "type": "string", "minLength": 1 },
        "channel": { "$ref": "#/$defs/InteractionChannel" },
        "mode": { "type": "string", "minLength": 1 },
        "max_distance_m": { "type": "number", "minimum": 0.0 }
      }
    },
    "OpEstablish": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "subject_id"],
      "properties": {
        "family": { "const": "ESTABLISH" },
        "subject_id": { "type": "string", "minLength": 1 },
        "initial_scale": { "type": "number", "exclusiveMinimum": 0.0 },
        "propagation": { "$ref": "#/$defs/PropagationSpec" }
      }
    },
    "OpDrive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "target_subject_id", "channel", "mode", "strength", "profile"],
      "properties": {
        "family": { "const": "DRIVE" },
        "target_subject_id": { "type": "string", "minLength": 1 },
        "channel": {
          "type": "string",
          "enum": ["POSE", "EXTENT", "DISTRIBUTION", "FLOW", "INTENSITY", "DIRECTION", "VELOCITY_IMPULSE"]
        },
        "mode": { "type": "string", "enum": ["TARGET", "RATE", "IMPULSE"] },
        "target_ref": { "type": "string" },
        "strength": { "type": "number" },
        "profile": { "$ref": "#/$defs/ProfileSpec" },
        "propagation": { "$ref": "#/$defs/PropagationSpec" }
      }
    },
    "OpConstrain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "target_subject_id",
        "constraint_family",
        "desired_value",
        "tolerance",
        "capacity",
        "on_exceed",
        "provider_ref"
      ],
      "properties": {
        "family": { "const": "CONSTRAIN" },
        "target_subject_id": { "type": "string", "minLength": 1 },
        "constraint_family": {
          "type": "string",
          "enum": ["POSITION", "DISTANCE", "ATTACH", "COHESION", "SUPPORT", "CONFORM", "CONTAIN", "BOUND"]
        },
        "anchor_ref": { "type": "string" },
        "desired_value": { "type": "number" },
        "tolerance": { "type": "number", "minimum": 0.0 },
        "capacity": { "type": "number", "minimum": 0.0 },
        "on_exceed": { "type": "string", "enum": ["YIELD", "DEFORM", "BREAK"] },
        "provider_ref": {
          "type": "string",
          "enum": ["CASTER_MANA", "POST_RELEASE_RESERVE", "VESSEL_RESERVE", "WORLD_ANCHOR"]
        }
      }
    },
    "OpTransform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "target_subject_id", "transform_id", "preserve"],
      "properties": {
        "family": { "const": "TRANSFORM" },
        "target_subject_id": { "type": "string", "minLength": 1 },
        "transform_id": {
          "type": "string",
          "enum": [
            "PATH_LIQUID_TO_BODY_SOLID",
            "BODY_SOLID_TO_SHARDS",
            "BODY_SOLID_TO_LIQUID_REGION",
            "FOG_REGION_TO_ICE_SHARDS",
            "FIELD_RECONFIGURE"
          ]
        },
        "preserve": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["MATERIAL_QUANTITY", "CURRENT_GEOMETRY", "VALID_CONNECTIONS", "CURRENT_MOMENTUM"]
          }
        },
        "max_output_bodies": { "type": "integer", "minimum": 1, "maximum": 12 },
        "propagation": { "$ref": "#/$defs/PropagationSpec" }
      }
    },
    "OpTransfer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "source_ref",
        "target_subject_id",
        "resource_kind",
        "rate",
        "max_amount",
        "on_insufficient_source"
      ],
      "properties": {
        "family": { "const": "TRANSFER" },
        "source_ref": { "type": "string", "minLength": 1 },
        "target_subject_id": { "type": "string", "minLength": 1 },
        "resource_kind": { "type": "string", "enum": ["MATERIAL", "ENERGY", "HEAT", "VITALITY"] },
        "rate": { "type": "number", "minimum": 0.0 },
        "max_amount": { "type": "number", "minimum": 0.0 },
        "on_insufficient_source": {
          "type": "string",
          "enum": ["FAIL_ESTABLISH", "CLAMP_TO_AVAILABLE", "FALLBACK_TO_MANA_GEN"]
        }
      }
    },
    "OpCouple": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "coupling_id", "source_ref", "target_ref"],
      "properties": {
        "family": { "const": "COUPLE" },
        "coupling_id": {
          "type": "string",
          "enum": [
            "DISTURBANCE_TO_PERCEPTION",
            "SUBJECT_POSE_TO_FIELD_ORIGIN",
            "CONTACT_TO_TRIGGER",
            "CONTACT_TO_CONDUCTION",
            "HEAT_FLUX_TO_PHASE"
          ]
        },
        "source_ref": { "type": "string", "minLength": 1 },
        "target_ref": { "type": "string", "minLength": 1 },
        "signal_granularity": {
          "type": "string",
          "enum": ["NONE", "BINARY_PING", "DIRECTION_AND_INTENSITY_ONLY"]
        }
      }
    },
    "OpWithdraw": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "target_scope", "mode"],
      "properties": {
        "family": { "const": "WITHDRAW" },
        "target_scope": {
          "type": "string",
          "enum": ["SUBJECT", "RELATION", "PROCESS", "ALL_SPELL_SUPPORTS"]
        },
        "target_id": { "type": "string" },
        "mode": { "type": "string", "enum": ["STOP_SUPPORT", "DETACH_CONTROL"] }
      }
    },
    "OperationSpec": {
      "oneOf": [
        { "$ref": "#/$defs/OpEstablish" },
        { "$ref": "#/$defs/OpDrive" },
        { "$ref": "#/$defs/OpConstrain" },
        { "$ref": "#/$defs/OpTransform" },
        { "$ref": "#/$defs/OpTransfer" },
        { "$ref": "#/$defs/OpCouple" },
        { "$ref": "#/$defs/OpWithdraw" }
      ]
    },
    "ProcessSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "start", "operations", "end", "transitions"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "role": {
          "type": "string",
          "enum": ["OMEN_BUILDUP", "FORMATION", "ACTIVE_EFFECT", "PHASE_TRANSITION", "PAYOFF"]
        },
        "start": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": { "type": "string", "enum": ["ON_CAST_START", "ON_EVENT"] },
            "event": { "$ref": "#/$defs/EventType" }
          }
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/OperationSpec" }
        },
        "end": {
          "type": "object",
          "additionalProperties": false,
          "required": ["events", "max_duration_s"],
          "properties": {
            "events": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/EventType" }
            },
            "max_duration_s": { "type": "number", "minimum": 0.0 }
          }
        },
        "transitions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["on_event", "next_process_id", "action"],
            "properties": {
              "on_event": { "$ref": "#/$defs/EventType" },
              "next_process_id": { "type": ["string", "null"] },
              "action": {
                "type": "string",
                "enum": [
                  "HANDOFF_TO_RESERVE",
                  "DETACH_CONTROL",
                  "WITHDRAW_ALL_HANDLES",
                  "START_NEXT",
                  "COMPLETE"
                ]
              }
            }
          }
        }
      }
    },
    "ContractSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["combat", "interruption_priority"],
      "properties": {
        "combat": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "formation",
            "min_deliverable_progress",
            "full_charge_s",
            "charge_tiers",
            "on_under_threshold_release",
            "caster_movement",
            "dodge_cancel_policy",
            "inputs_used",
            "controller",
            "anchor_owner",
            "provider"
          ],
          "properties": {
            "formation": { "type": "string", "enum": ["INSTANT", "GRADUAL_CHARGE"] },
            "min_deliverable_progress": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
            "full_charge_s": { "type": "number", "minimum": 0.0 },
            "charge_tiers": {
              "type": "array",
              "minItems": 1,
              "maxItems": 3,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["min_progress", "scale_mul", "intensity_mul", "cost_mul"],
                "properties": {
                  "min_progress": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
                  "scale_mul": { "type": "number", "exclusiveMinimum": 0.0 },
                  "intensity_mul": { "type": "number", "exclusiveMinimum": 0.0 },
                  "cost_mul": { "type": "number", "exclusiveMinimum": 0.0 }
                }
              }
            },
            "on_under_threshold_release": {
              "type": "string",
              "enum": ["FIZZLE_PARTIAL_REFUND", "DELIVER_MIN_TIER"]
            },
            "caster_movement": {
              "type": "string",
              "enum": ["FULL_MOVE", "SLOW_SOLEMN_WALK", "ROOTED"]
            },
            "dodge_cancel_policy": {
              "type": "string",
              "enum": ["TRIGGER_INTERRUPT", "TRIGGER_RELEASE", "LOCKED_ON_COMMIT"]
            },
            "inputs_used": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "enum": [
                  "AIM_POINT",
                  "AIM_DIRECTION",
                  "LOCKED_TARGET",
                  "CAST_HOLD",
                  "VOLUNTARY_RELEASE",
                  "INTERRUPT_SIGNAL",
                  "SINGLE_FOCUS_RAY"
                ]
              }
            },
            "controller": {
              "type": "string",
              "enum": ["CASTER_FOCUS", "AUTONOMOUS", "ANCHOR_TRIGGER"]
            },
            "anchor_owner": {
              "type": "string",
              "enum": ["WORLD_FIXED", "CASTER", "TARGET", "VESSEL_OBJECT"]
            },
            "provider": {
              "type": "object",
              "additionalProperties": false,
              "required": ["material_source", "energy_source", "post_release_reserve_mana"],
              "properties": {
                "material_source": {
                  "type": "string",
                  "enum": ["NONE", "CASTER_MANA_GEN", "ENVIRONMENT_ONLY", "ENVIRONMENT_WITH_MANA_FALLBACK", "VESSEL_RESERVE"]
                },
                "energy_source": { "type": "string", "enum": ["CASTER_MANA", "VESSEL_RESERVE", "WORLD_SOURCE"] },
                "post_release_reserve_mana": { "type": "number", "minimum": 0.0 }
              }
            }
          }
        },
        "interruption_priority": {
          "type": "string",
          "enum": ["INTERRUPT_WINS_UNLESS_COMMITTED", "RELEASE_WINS_IF_DELIVERABLE"]
        }
      }
    },
    "ExpressionSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "composition",
        "symmetry",
        "tension",
        "contrast",
        "delivery",
        "aftermath_style",
        "visual_hints",
        "audio_profile"
      ],
      "properties": {
        "composition": {
          "type": "string",
          "enum": ["CONCENTRATED", "STREAMING", "ENVELOPING", "STRUCTURAL", "DIFFUSE"]
        },
        "symmetry": { "type": "string", "enum": ["NONE", "AXIAL", "RADIAL", "PLANAR"] },
        "tension": {
          "type": "string",
          "enum": ["NONE", "GRADUAL_ACCUMULATION", "SUSTAINED_STRAIN", "INSTANT_SNAP"]
        },
        "contrast": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH"] },
        "delivery": {
          "type": "string",
          "enum": ["CONTINUOUS", "CONCENTRATED", "BURST", "PASSIVE"]
        },
        "aftermath_style": {
          "type": "string",
          "enum": ["NONE", "RESTRAINED", "LINGERING_DECAY", "MONUMENTAL_RESIDUE"]
        },
        "visual_hints": {
          "type": "object",
          "additionalProperties": false,
          "required": ["material_style", "accent_color_hex"],
          "properties": {
            "material_style": { "type": "string", "minLength": 1 },
            "accent_color_hex": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
          }
        },
        "audio_profile": {
          "type": "object",
          "additionalProperties": false,
          "required": ["drone_family", "silence_pre_impact_ms", "impact_family", "sustain_loop_family"],
          "properties": {
            "drone_family": { "type": "string", "minLength": 1 },
            "silence_pre_impact_ms": { "type": "integer", "minimum": 0, "maximum": 120 },
            "impact_family": { "type": "string", "minLength": 1 },
            "sustain_loop_family": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "BudgetSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "derived_upfront_mana",
        "derived_sustain_mana_per_s",
        "derived_reserve_mana",
        "environment_discount_applied",
        "subject_count",
        "process_count",
        "peak_nodes",
        "peak_edges",
        "peak_surface_quads",
        "peak_fracture_bodies",
        "compiler_status"
      ],
      "properties": {
        "derived_upfront_mana": { "type": "number", "minimum": 0.0 },
        "derived_sustain_mana_per_s": { "type": "number", "minimum": 0.0 },
        "derived_reserve_mana": { "type": "number", "minimum": 0.0 },
        "environment_discount_applied": { "type": "boolean" },
        "subject_count": { "type": "integer", "minimum": 1, "maximum": 8 },
        "process_count": { "type": "integer", "minimum": 1, "maximum": 8 },
        "peak_nodes": { "type": "integer", "minimum": 0, "maximum": 16 },
        "peak_edges": { "type": "integer", "minimum": 0, "maximum": 24 },
        "peak_surface_quads": { "type": "integer", "minimum": 0, "maximum": 64 },
        "peak_fracture_bodies": { "type": "integer", "minimum": 0, "maximum": 12 },
        "compiler_status": { "type": "string", "enum": ["VALID", "REJECTED"] }
      }
    }
  }
}
