{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fpddmw.github.io/magic-3D/schema/semantic_intent_v0_2.schema.json",
  "title": "SemanticIntent v0.2.1",
  "description": "Compositional semantic intent layer strictly separated from compiled execution DSL. Uses atomic meaning clauses and mandatory rune-to-binding traceability instead of compound spell enums.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "intent_id",
    "display_title",
    "clauses",
    "rune_contributions",
    "caster_context",
    "expected_omen_tone"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2.1"
    },
    "intent_id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$",
      "minLength": 2,
      "maxLength": 64
    },
    "display_title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "clauses": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/IntentClauseSpec"
      }
    },
    "rune_contributions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/RuneContributionSpec"
      }
    },
    "caster_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested_targeting", "max_desired_range_m", "allow_post_release_persist"],
      "properties": {
        "requested_targeting": {
          "type": "string",
          "enum": ["POINT", "DIRECTION", "SELF_OR_ANCHOR", "LOCKED_ACTOR", "VESSEL_TOUCH"]
        },
        "max_desired_range_m": { "type": "number", "minimum": 0.0, "maximum": 40.0 },
        "allow_post_release_persist": { "type": "boolean" }
      }
    },
    "expected_omen_tone": {
      "type": "string",
      "enum": [
        "SUBTLE_INSTANT",
        "CRYSTAL_CLARITY",
        "CRUSHING_GRAVITY",
        "SILENT_VEIL",
        "ARCANE_WARD",
        "VOLATILE_STORM",
        "RITUAL_SEAL"
      ]
    }
  },
  "$defs": {
    "IntentClauseSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clause_id",
        "clause_role",
        "target_archetype",
        "spatial_topology",
        "semantic_polarity",
        "temporal_phase",
        "qualifiers"
      ],
      "properties": {
        "clause_id": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$" },
        "clause_role": {
          "type": "string",
          "enum": [
            "MANIFEST",
            "SHAPE_AND_ROUTE",
            "APPLY_FORCE",
            "MODULATE_FIELD",
            "TRANSFORM_STATE",
            "HOLD_CONSTRAINT",
            "DETECT_AND_COUPLE",
            "TRIGGER_ON_CONTACT",
            "INVERT_OR_REDIRECT",
            "CONSUME_RESERVE"
          ]
        },
        "target_archetype": {
          "type": "string",
          "enum": [
            "WATER_MEDIUM",
            "ICE_CRYSTAL",
            "STONE_MATTER",
            "METAL_CONDUCTOR",
            "FOG_MIST",
            "FLAME_HEAT",
            "ELECTRIC_CHARGE",
            "GRAVITY_WELL",
            "HEAT_SINK",
            "LIGHT_SCREEN",
            "BARRIER_PLANE",
            "WORLD_VESSEL",
            "NEARBY_MEDIUM",
            "CASTER",
            "TARGET_SPACE"
          ]
        },
        "spatial_topology": {
          "type": "string",
          "enum": [
            "POINT_OR_BODY",
            "FILAMENT_GRAPH",
            "BOUNDED_SHEET",
            "INFLUENCE_REGION",
            "WORLD_ANCHOR"
          ]
        },
        "semantic_polarity": {
          "type": "string",
          "enum": ["STANDARD", "INVERTED"]
        },
        "scope_target_clause_id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$"
        },
        "directional_intent": {
          "type": "string",
          "enum": [
            "FORWARD",
            "UPWARD",
            "DOWNWARD",
            "RADIAL_INWARD",
            "RADIAL_OUTWARD",
            "LATERAL",
            "NONE"
          ]
        },
        "temporal_phase": {
          "type": "string",
          "enum": ["ON_CAST", "WHILE_HELD", "ON_RELEASE", "ON_TRIGGER", "POST_RELEASE"]
        },
        "qualifiers": {
          "type": "array",
          "minItems": 0,
          "maxItems": 6,
          "items": {
            "type": "string",
            "enum": [
              "HARVEST_NEARBY",
              "CONDENSE_AND_COMPRESS",
              "SOLIDIFY_PHASE",
              "CONDUCT_OVER_WET_OR_METAL",
              "CONCEAL_VISIBILITY",
              "SENSE_DISTURBANCE",
              "ONE_WAY_FILTER",
              "IMPRINT_UNTIL_TRIGGER",
              "PRESERVE_ANCHORS",
              "NON_LETHAL_CONTROL"
            ]
          }
        }
      }
    },

    "RuneContributionSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rune_token", "rune_category", "target_clause_ids", "bound_ids"],
      "properties": {
        "rune_token": { "type": "string", "minLength": 1, "maxLength": 48 },
        "rune_category": {
          "type": "string",
          "enum": [
            "SUBJECT_SEED",
            "TOPOLOGY_GLYPH",
            "VECTOR_GLYPH",
            "FIELD_SIGN",
            "PHASE_SIGN",
            "BINDING_SIGN",
            "TRIGGER_SEAL",
            "MODIFIER_INVERT"
          ]
        },
        "target_clause_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$" }
        },
        "bound_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$" }
        }
      }
    }
  }
}
