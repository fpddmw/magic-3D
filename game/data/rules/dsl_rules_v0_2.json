{
  "schema_version": "0.2.2",
  "description": "Single authoritative rule registry for Magic DSL v0.2.2. Wave 0 Python and GDScript validators, budget calculators, ArtKit baseline mappers, and deterministic rune compilers MUST load and enforce this file rather than duplicating magic numbers or enums.",
  "hard_limits": {
    "max_subjects": 8,
    "max_spatials": 8,
    "max_relations": 12,
    "max_processes": 8,
    "max_entry_processes": 4,
    "max_dynamic_bodies_per_spell": 16,
    "max_global_dynamic_bodies": 64,
    "max_path_nodes": 16,
    "max_path_edges": 24,
    "max_surface_quads": 64,
    "max_point_lights": 3,
    "max_deflect_iterations_per_node": 2,
    "min_rebind_cooldown_s": 0.05,
    "max_propagate_hops": 12,
    "max_propagate_reach_m": 30.0,
    "max_pre_delivery_silence_ms": 120,
    "max_hitstop_local_ms": 140,
    "max_active_duration_s": 30.0,
    "max_upfront_mana": 300.0,
    "max_sustain_mana_per_s": 60.0,
    "max_reserve_mana": 200.0,
    "max_tick_cost_us": 300
  },
  "process_graph_rules": {
    "require_dag": true,
    "require_global_unique_handle_ids": true,
    "require_linear_handle_ownership": true,
    "forbid_parallel_exclusive_handle_duplication": true,
    "establish_allowed_phases": ["on_enter"],
    "impulse_allowed_phases": ["on_enter", "on_exit"],
    "propagation_allowed_ops": ["TRANSFORM", "DRIVE", "TRANSFER"],
    "require_spatial_for_subject_kinds": ["MATERIAL", "FIELD"]
  },
  "material_valid_initial_phases": {
