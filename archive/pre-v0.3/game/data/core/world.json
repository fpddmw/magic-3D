{
  "core_version": "0.1.2",
  "axioms": [
    {
      "id": "AX.nature",
      "name": "本性",
      "rule": "主体按其本性提供默认性质、能力及自然演化。"
    },
    {
      "id": "AX.aspect",
      "name": "性质",
      "rule": "可以引用已有性质，改变或独立化须给出相应权限与承载。"
    },
    {
      "id": "AX.relation",
      "name": "关系",
      "rule": "端点、通道、内容与有效条件共同决定一项联系能传什么。"
    },
    {
      "id": "AX.organization",
      "name": "组织",
      "rule": "各部分的组织可产生整体性质，前提是所需结构与关系有效。"
    },
    {
      "id": "AX.change",
      "name": "变化",
      "rule": "干预有确定对象和范围，可改变状态、组织及获准干涉的规律。"
    },
    {
      "id": "AX.aether",
      "name": "以太",
      "rule": "以太承载超出自然条件的存在、性质与作用关系。每项具体能力另需语义依据。"
    },
    {
      "id": "AX.cost",
      "name": "代价",
      "rule": "建立、维持、转移和交付分别有供给者与责任终点。"
    },
    {
      "id": "AX.cause",
      "name": "因果",
      "rule": "事件依事实接续；撤除主动作用以后，已经形成的世界状态继续演化。"
    },
    {
      "id": "E1",
      "name": "以太媒介",
      "rule": "以太是异常存在、性质与关系的成立媒介，不是无限能源。"
    },
    {
      "id": "E2",
      "name": "意义与代价",
      "rule": "意义决定魔法的内容，魔力承担干预的代价。"
    },
    {
      "id": "E3",
      "name": "五种干预",
      "rule": "魔法通过具现、调动、重构、赋予及干涉改变世界。"
    },
    {
      "id": "E4",
      "name": "局部规律",
      "rule": "魔法可以改变局部规律的实际作用，但不能任意改写世界公理。"
    },
    {
      "id": "E5",
      "name": "成立条件",
      "rule": "魔法成立需要世界许可、充分意义、实际条件与足够责任。"
    },
    {
      "id": "E6",
      "name": "魔法作为对象",
      "rule": "已经成立的魔法本身可以成为其他魔法的作用对象。"
    },
    {
      "id": "E7",
      "name": "共同因果",
      "rule": "所有魔法共同参与世界因果，依照实际性质、关系及承担能力产生结果。"
    }
  ],
