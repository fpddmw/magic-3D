{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fpddmw.github.io/magic-3D/schema/semantic_intent_v0_2.schema.json",
  "title": "SemanticIntent v0.2.2",
  "description": "Clean compositional semantic intent schema built strictly over the project's 50 real Chinese runes (48 base lexicon + 重/界). Downstream compiler emits CompileTraceSpec separately; upstream SemanticIntent never guesses compiled DSL IDs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "intent_id",
    "display_title",
    "clauses",
    "rune_contributions",
    "caster_context",
    "expected_omen_tone"
  ],
  "properties": {
    "schema_version": { "const": "0.2.2" },
    "intent_id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$",
      "minLength": 2,
      "maxLength": 64
    },
    "display_title": { "type": "string", "minLength": 1, "maxLength": 64 },
    "clauses": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": { "$ref": "#/$defs/IntentClauseSpec" }
    },
    "rune_contributions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": { "$ref": "#/$defs/RuneContributionSpec" }
    },
    "caster_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested_targeting", "max_desired_range_m", "allow_post_release_persist"],
      "properties": {
        "requested_targeting": {
          "type": "string",
          "enum": ["POINT", "DIRECTION", "SELF_OR_ANCHOR", "LOCKED_ACTOR", "VESSEL_TOUCH"]
        },
        "max_desired_range_m": { "type": "number", "minimum": 0.0, "maximum": 40.0 },
        "allow_post_release_persist": { "type": "boolean" }
      }
    },
    "expected_omen_tone": {
      "type": "string",
      "enum": [
        "SUBTLE_INSTANT",
        "CRYSTAL_CLARITY",
        "CRUSHING_GRAVITY",
        "SILENT_VEIL",
        "ARCANE_WARD",
        "VOLATILE_STORM",
        "RITUAL_SEAL"
      ]
    }
  },
  "$defs": {
    "RealRuneLexicon": {
      "type": "string",
      "enum": [
        "土", "水", "气", "火", "以太",
        "凝固", "融化", "弥散", "精炼", "分离", "对立", "对称", "调和", "循环", "反转", "离体",
        "凝聚", "环绕", "铺展", "包覆", "延展", "交织", "联结", "包围",
        "汇聚", "扩散", "追随", "牵引", "排斥", "回旋", "传递", "穿透",
        "吸纳", "封存", "释放", "潜伏", "唤醒", "延续", "爆发", "归还",
        "守护", "寻觅", "束缚", "滋养", "侵蚀", "共鸣", "借用", "回应",
        "重", "界"
      ]
    },

    "IntentClauseSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "meaning", "input_refs", "timing"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$" },
        "meaning": { "$ref": "#/$defs/RealRuneLexicon" },
        "subject_ref": { "type": "string", "minLength": 1, "maxLength": 64 },
        "input_refs": {
          "type": "array",
          "minItems": 0,
          "maxItems": 6,
          "items": { "type": "string", "minLength": 1, "maxLength": 64 }
        },
        "scope_target_clause_id": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$" },
        "timing": {
          "type": "string",
          "enum": ["ON_CAST", "WHILE_HELD", "ON_RELEASE", "ON_INTERRUPT", "ON_TRIGGER", "POST_RELEASE"]
        }
      },
      "if": {
        "required": ["meaning"],
        "properties": { "meaning": { "const": "反转" } }
      },
      "then": {
        "required": ["scope_target_clause_id"]
      }
    },

    "RuneContributionSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rune_id", "role_in_circuit", "clause_ids"],
      "properties": {
        "rune_id": { "$ref": "#/$defs/RealRuneLexicon" },
        "role_in_circuit": {
          "type": "string",
          "enum": ["SUBJECT", "FORM", "ACTION", "MODIFIER", "RELATION", "CONTRACT"]
        },
        "clause_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$" }
        }
      }
    },

    "CompileTraceSpec": {
      "type": "object",
      "description": "Emitted ONLY downstream by the deterministic compiler alongside CompiledSpellDSL to record which compiled subject/spatial/relation/process IDs implement each SemanticIntent clause.",
      "additionalProperties": false,
      "required": ["schema_version", "intent_id", "spell_id", "clause_bindings"],
      "properties": {
        "schema_version": { "const": "0.2.2" },
        "intent_id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "spell_id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "clause_bindings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["clause_id", "dsl_ids"],
            "properties": {
              "clause_id": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$" },
              "dsl_ids": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$" }
              }
            }
          }
        }
      }
    }
  }
}
